# ==========================================
# CLIENT ENVIRONMENT CONFIGURATION (Vite)
# ==========================================

# Base URL for the backend API & Socket.io server
# In Production on Render (Static Site), set this to your Render Web Service backend URL:
# Example: https://mocktest-server.onrender.com
#
# In Local Development, leave empty so Vite proxies '/api' to http://localhost:5000 automatically.
VITE_API_URL=

