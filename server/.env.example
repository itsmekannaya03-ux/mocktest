# ==========================================
# SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Port & Host binding
# On Render Web Service, Render dynamically assigns PORT (usually 10000).
# The server automatically listens on process.env.PORT and binds to 0.0.0.0.
PORT=5000
HOST=0.0.0.0

# Security Secrets
# Change this to a strong, random, secret key in production!
JWT_SECRET=IRIS_CYBER_SHIELD_SECRET_KEY_CHANGE_IN_PRODUCTION_2026

# Allowed CORS origins
# Set this to your frontend domain in production (e.g. https://mocktest-client.onrender.com)
# Or leave as '*' to allow all origins.
CORS_ORIGIN=*

# Administrator Entry Codes (Optional overrides)
TONY_ADMIN_NUMBER=224488
CAP_ADMIN_NUMBER=224489

